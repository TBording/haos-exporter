haos_exporter_collector_success{collector="backups_info"} 1
haos_exporter_collector_success{collector="core_info"} 1
haos_exporter_collector_success{collector="core_probe"} 1
haos_exporter_collector_success{collector="host_info"} 1
haos_exporter_collector_success{collector="os_info"} 1
haos_exporter_collector_success{collector="resolution_info"} 1
haos_exporter_collector_success{collector="supervisor_info"} 1
