haos_exporter_collector_last_success_timestamp_seconds{collector="supervisor_info"} 1.79e+09
# HELP haos_exporter_collector_poll_interval_seconds How often the Supervisor-backed collector is polled.
# TYPE haos_exporter_collector_poll_interval_seconds gauge
haos_exporter_collector_poll_interval_seconds{collector="backups_info"} 300
